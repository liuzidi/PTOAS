// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --enable-vmi --enable-op-fusion --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --emit-vpto %s -o /dev/null --mlir-print-ir-after=pto-expand-tile-op 2>&1 | FileCheck %s --check-prefix=EXPAND
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --enable-vmi --enable-op-fusion --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --emit-vpto %s -o - | FileCheck %s --check-prefix=FINAL --implicit-check-not=pto.vmi.v --implicit-check-not=!pto.vmi.

module {
  func.func @narrow_rowmax() {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 16x32xf32>
    %workspace = pto.alloc_tile : !pto.tile_buf<vec, 16x32xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 16x1xf32, blayout=col_major>
    pto.trowmax
      ins(%src, %workspace : !pto.tile_buf<vec, 16x32xf32>, !pto.tile_buf<vec, 16x32xf32>)
      outs(%dst : !pto.tile_buf<vec, 16x1xf32, blayout=col_major>)
    return
  }

  func.func @narrow_rowsum() {
    %src = pto.alloc_tile : !pto.tile_buf<vec, 8x32xf32>
    %workspace = pto.alloc_tile : !pto.tile_buf<vec, 8x128xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 8x1xf32, blayout=col_major>
    pto.trowsum
      ins(%src, %workspace : !pto.tile_buf<vec, 8x32xf32>, !pto.tile_buf<vec, 8x128xf32>)
      outs(%dst : !pto.tile_buf<vec, 8x1xf32, blayout=col_major>)
    return
  }
}

// EXPAND-LABEL: func.func @narrow_rowmax
// EXPAND: call {{.*}}__vmi_trowmax_row
// EXPAND-SAME: pto.tilelib.candidate = "vmi_trowmax_row"
// EXPAND-SAME: pto.vmi.resource.estimate_exact = true
// EXPAND-SAME: pto.vmi.resource.estimated_peak_vector_bytes = 256 : i64
// EXPAND-LABEL: func.func @narrow_rowsum
// EXPAND: call {{.*}}__vmi_trowsum_row
// EXPAND-SAME: pto.tilelib.candidate = "vmi_trowsum_row"
// EXPAND-SAME: pto.vmi.resource.estimate_exact = true
// EXPAND-SAME: pto.vmi.resource.estimated_peak_vector_bytes = 512 : i64
// FINAL-LABEL: func.func @narrow_rowmax
// FINAL: scf.for
// FINAL: pto.vcmax
// FINAL: pto.vmax
// FINAL: pto.vsts {{.*}} {dist = "1PT_B32"}
// FINAL-LABEL: func.func @narrow_rowsum
// FINAL: scf.for
// FINAL: pto.vcadd
// FINAL: pto.vadd
// FINAL: pto.vsts {{.*}} {dist = "1PT_B32"}
