// merged-device-only is intentionally a single-entry-per-ELF output mode: the
// simpler scheduler selects the ELF by func_id and enters its sole
// kernel_entry. Modules with multiple explicit entries must be rejected with
// a diagnostic that names the constraint and the alternatives (split per
// kernel kind, or use the regular fatobj route).

// RUN: not ptoas --pto-arch=a5 --pto-backend=vpto --vpto-emit-merged-device-only %s -o /dev/null 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    func.func @first_kernel() attributes {pto.entry} {
      %ctrl = pto.get_ctrl : i64
      pto.set_ctrl %ctrl : i64
      return
    }
    func.func @second_kernel() attributes {pto.entry} {
      %ctrl = pto.get_ctrl : i64
      pto.set_ctrl %ctrl : i64
      return
    }
  }
}

// CHECK: Error: --vpto-emit-merged-device-only requires exactly
// CHECK: one PTO entry function per device ELF
// CHECK: Split the input per kernel kind
