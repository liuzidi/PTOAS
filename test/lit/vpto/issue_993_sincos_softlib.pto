// Guards late A5 PTODSL SoftLib materialization for SIMT sin/cos.
// The operations are intentionally f32 scalar hooks, not native vector ops.

// RUN: ( ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - 2>&1 || true ) | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @issue_993_sincos(%x: f32, %dst: !pto.ptr<f32, ub>) attributes {pto.simt_entry} {
    %zero = arith.constant 0 : index
    %s = pto.sin %x : f32 -> f32
    %c = pto.cos %x : f32 -> f32
    pto.store %s, %dst[%zero] : !pto.ptr<f32, ub>, f32
    pto.store %c, %dst[%zero] : !pto.ptr<f32, ub>, f32
    return
  }
}

// CHECK: error: cannot be converted to LLVM IR: missing `LLVMTranslationDialectInterface` registration for dialect for op: pto.sin
// CHECK: VPTO LLVM emission failed: LLVM IR export failed for vector module
