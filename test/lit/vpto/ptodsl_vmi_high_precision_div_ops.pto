// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --enable-op-fusion=false --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --emit-vpto %s -o /dev/null --mlir-print-ir-after=pto-expand-tile-op 2>&1 | FileCheck %s --check-prefix=EXPAND
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --enable-op-fusion=false --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --emit-vpto %s -o /dev/null --mlir-print-ir-after=pto-inline-libcall 2>&1 | FileCheck %s --check-prefix=INLINE --implicit-check-not=__pto_ptodsl_vmi --implicit-check-not=pto.vecscope
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --pto-arch=a5 --pto-backend=vpto --enable-op-fusion=false --tile-lib-backend=ptodsl --ptodsl-python-exe=%python_executable --emit-vpto %s -o - | FileCheck %s --check-prefix=FINAL --implicit-check-not=__pto_ptodsl_vmi

module {
  func.func @ptodsl_vmi_high_precision_div_ops() {
    %src0_f32 = pto.alloc_tile : !pto.tile_buf<vec, 2x64xf32>
    %src1_f32 = pto.alloc_tile : !pto.tile_buf<vec, 2x64xf32>
    %dst_f32 = pto.alloc_tile : !pto.tile_buf<vec, 2x64xf32>
    %src0_f16 = pto.alloc_tile : !pto.tile_buf<vec, 2x128xf16>
    %src1_f16 = pto.alloc_tile : !pto.tile_buf<vec, 2x128xf16>
    %dst_f16 = pto.alloc_tile : !pto.tile_buf<vec, 2x128xf16>
    %tmp_f32 = pto.alloc_tile : !pto.tile_buf<vec, 1x16xf32>
    %scalar = arith.constant 2.000000e+00 : f32

    pto.tdiv
      ins(%src0_f32, %src1_f32 : !pto.tile_buf<vec, 2x64xf32>, !pto.tile_buf<vec, 2x64xf32>)
      outs(%dst_f32 : !pto.tile_buf<vec, 2x64xf32>)
      {precisionType = #pto<div_precision high_precision>}
    pto.tdiv
      ins(%src0_f16, %src1_f16 : !pto.tile_buf<vec, 2x128xf16>, !pto.tile_buf<vec, 2x128xf16>)
      outs(%dst_f16 : !pto.tile_buf<vec, 2x128xf16>)
      {precisionType = #pto<div_precision high_precision>}
    pto.tdivs
      ins(%src0_f32, %scalar : !pto.tile_buf<vec, 2x64xf32>, f32)
      outs(%dst_f32 : !pto.tile_buf<vec, 2x64xf32>)
      {precisionType = #pto<div_precision high_precision>}
    pto.tdivs
      ins(%scalar, %src0_f32 : f32, !pto.tile_buf<vec, 2x64xf32>)
      outs(%dst_f32 : !pto.tile_buf<vec, 2x64xf32>)
      {precisionType = #pto<div_precision high_precision>}
    pto.trecip
      ins(%src0_f32 : !pto.tile_buf<vec, 2x64xf32>)
      outs(%dst_f32 : !pto.tile_buf<vec, 2x64xf32>)
      {precisionType = #pto<recip_precision high_precision>}
    pto.trsqrt
      ins(%src0_f32, %tmp_f32 : !pto.tile_buf<vec, 2x64xf32>, !pto.tile_buf<vec, 1x16xf32>)
      outs(%dst_f32 : !pto.tile_buf<vec, 2x64xf32>)
      {precisionType = #pto<rsqrt_precision high_precision>}
    return
  }
}

// EXPAND: call {{.*}}__pto_ptodsl_vmi_a5_tdiv
// EXPAND: call {{.*}}__pto_ptodsl_vmi_a5_tdiv
// EXPAND: call {{.*}}__pto_ptodsl_vmi_a5_tdivs
// EXPAND: call {{.*}}__pto_ptodsl_vmi_a5_tdivs
// EXPAND: call {{.*}}__pto_ptodsl_vmi_a5_trecip
// EXPAND: call {{.*}}__pto_ptodsl_vmi_a5_trsqrt

// INLINE-LABEL: func.func @ptodsl_vmi_high_precision_div_ops
// INLINE-DAG: pto.vmi.vdiv
// INLINE-DAG: pto.vmi.vmula
// INLINE-DAG: pto.vmi.vinterpret_cast
// INLINE-DAG: pto.vmi.vcmp
// INLINE-DAG: pto.vmi.vshl
// INLINE-DAG: pto.vmi.vshr
// INLINE-DAG: pto.vmi.vsel
// INLINE-DAG: pto.vmi.vsqrt
// INLINE-DAG: pto.vmi.vcmps

// FINAL-LABEL: func.func @ptodsl_vmi_high_precision_div_ops
// FINAL: pto.vecscope
// FINAL: pto.vdiv
// FINAL: pto.vmula
// FINAL: pto.vcmp
// FINAL: pto.vsel
