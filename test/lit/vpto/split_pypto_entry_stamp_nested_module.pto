// Regression guard for PyPTO entry stamping with nested modules present.
// stampPyPTOEntryAttribute counts func.call callees within one module's own
// functions only and skips modules whose body contains nested child modules
// (they are separate compile units; their calls must not reclassify the
// outer functions, and the mixed top-level shape is not the canonical PyPTO
// single-kernel module). Here each kernel submodule is stamped independently:
// the public uncalled kind-tagged kernel becomes the entry, the called
// private helper does not.

// RUN: pto-test-opt --vpto-split-cv-module %s | FileCheck %s

module attributes {pto.target_arch = "a5"} {
  func.func @nested_shape_kernel(%arg0: !pto.ptr<f32>, %arg1: i32, %arg2: i32) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    func.call @nested_callee() : () -> ()
    return
  }
  func.func private @nested_callee() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    return
  }
  module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    func.func @child_unit_func() {
      return
    }
  }
}

// The top-level module contains a nested child module, so no implicit
// `pto.entry` is stamped on the top-level functions.
// CHECK: func.func @nested_shape_kernel{{.*}}attributes {pto.kernel_kind = #pto.kernel_kind<vector>}
// CHECK-NOT: attributes {{.*}}pto.entry
