// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl --emit-vpto %s -o /dev/null --mlir-print-ir-after=pto-expand-tile-op 2>&1 | FileCheck %s --check-prefix=EXPAND
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl --emit-vpto %s -o /dev/null --mlir-print-ir-after=pto-inline-libcall 2>&1 | FileCheck %s --check-prefix=INLINE --implicit-check-not=pto.vecscope
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl --emit-vpto %s -o - | FileCheck %s --check-prefix=FINAL --implicit-check-not=pto.vmi.

module {
  func.func @ptodsl_vmi_sqrt_ops() {
    %src_f32 = pto.alloc_tile : !pto.tile_buf<vec, 2x64xf32>
    %dst_f32 = pto.alloc_tile : !pto.tile_buf<vec, 2x64xf32>
    %src_f16 = pto.alloc_tile : !pto.tile_buf<vec, 2x128xf16>
    %dst_f16 = pto.alloc_tile : !pto.tile_buf<vec, 2x128xf16>
    %tmp_f16 = pto.alloc_tile : !pto.tile_buf<vec, 1x16xf16>

    pto.tsqrt
      ins(%src_f32 : !pto.tile_buf<vec, 2x64xf32>)
      outs(%dst_f32 : !pto.tile_buf<vec, 2x64xf32>)
    pto.tsqrt
      ins(%src_f32 : !pto.tile_buf<vec, 2x64xf32>)
      outs(%dst_f32 : !pto.tile_buf<vec, 2x64xf32>)
      {precisionType = #pto<sqrt_precision high_precision>}
    pto.tsqrt
      ins(%src_f16 : !pto.tile_buf<vec, 2x128xf16>)
      outs(%dst_f16 : !pto.tile_buf<vec, 2x128xf16>)
      {precisionType = #pto<sqrt_precision high_precision>}
    pto.trsqrt
      ins(%src_f32 : !pto.tile_buf<vec, 2x64xf32>)
      outs(%dst_f32 : !pto.tile_buf<vec, 2x64xf32>)
    pto.trsqrt
      ins(%src_f16, %tmp_f16
          : !pto.tile_buf<vec, 2x128xf16>, !pto.tile_buf<vec, 1x16xf16>)
      outs(%dst_f16 : !pto.tile_buf<vec, 2x128xf16>)
    return
  }
}

// EXPAND: call {{.*}}__pto_tilelang_a5_tsqrt
// EXPAND: call {{.*}}__pto_tilelang_a5_tsqrt
// EXPAND: call {{.*}}__pto_tilelang_a5_tsqrt
// EXPAND: call {{.*}}__pto_tilelang_a5_trsqrt
// EXPAND: call {{.*}}__pto_tilelang_a5_trsqrt

// INLINE-LABEL: func.func @ptodsl_vmi_sqrt_ops
// INLINE-DAG: pto.vsqrt
// INLINE-DAG: pto.vdiv
// INLINE-DAG: pto.vmula
// INLINE-DAG: pto.vbitcast
// INLINE-DAG: pto.vor
// INLINE-DAG: pto.por
// INLINE-DAG: pto.vsel
// INLINE-DAG: pto.vcmps

// FINAL-LABEL: func.func @ptodsl_vmi_sqrt_ops
// FINAL: pto.vecscope
// FINAL: pto.vsqrt
// FINAL: pto.vmula
// FINAL: pto.vbitcast
// FINAL: pto.vdiv
