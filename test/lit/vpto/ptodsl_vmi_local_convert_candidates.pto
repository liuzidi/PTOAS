// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --enable-vmi --enable-op-fusion --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl --ptodsl-pkg-path=%S/../../../ptodsl --ptodsl-python-exe=%python_executable --emit-vpto %s -o /dev/null --mlir-print-ir-after=pto-expand-tile-op 2>&1 | FileCheck %s --check-prefix=EXPAND
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --enable-vmi --enable-op-fusion --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl --ptodsl-pkg-path=%S/../../../ptodsl --ptodsl-python-exe=%python_executable --emit-vpto %s -o /dev/null --mlir-print-ir-after=pto-inline-libcall 2>&1 | FileCheck %s --check-prefix=INLINE --implicit-check-not=__pto_ptodsl_vmi --implicit-check-not=pto.vecscope
// RUN: env MLIR_PYTHON_ROOT=%mlir_python_root ptoas --enable-vmi --enable-op-fusion --pto-arch=a5 --pto-backend=vpto --tile-lib-backend=ptodsl --ptodsl-pkg-path=%S/../../../ptodsl --ptodsl-python-exe=%python_executable --emit-vpto %s -o - | FileCheck %s --check-prefix=FINAL

module {
  func.func @local_convert_candidates() {
    %bf16 = pto.alloc_tile : !pto.tile_buf<vec, 8x128xbf16>
    %f16 = pto.alloc_tile : !pto.tile_buf<vec, 8x128xf16>
    %f32 = pto.alloc_tile : !pto.tile_buf<vec, 8x128xf32>
    %f32_1 = pto.alloc_tile : !pto.tile_buf<vec, 8x128xf32>
    %f32_2 = pto.alloc_tile : !pto.tile_buf<vec, 8x128xf32>
    %f32_3 = pto.alloc_tile : !pto.tile_buf<vec, 8x128xf32>
    %i32 = pto.alloc_tile : !pto.tile_buf<vec, 8x128xi32>
    %i32_1 = pto.alloc_tile : !pto.tile_buf<vec, 8x128xi32>
    %bf16_1 = pto.alloc_tile : !pto.tile_buf<vec, 8x128xbf16>
    %f16_1 = pto.alloc_tile : !pto.tile_buf<vec, 8x128xf16>
    %f16_2 = pto.alloc_tile : !pto.tile_buf<vec, 8x128xf16>

    pto.tcvt ins(%bf16 {rmode = #pto<round_mode ROUND>} : !pto.tile_buf<vec, 8x128xbf16>)
      outs(%f32 : !pto.tile_buf<vec, 8x128xf32>)
    pto.tcvt ins(%f16 {rmode = #pto<round_mode ROUND>} : !pto.tile_buf<vec, 8x128xf16>)
      outs(%f32_3 : !pto.tile_buf<vec, 8x128xf32>)
    pto.tcvt ins(%i32 {rmode = #pto<round_mode ROUND>} : !pto.tile_buf<vec, 8x128xi32>)
      outs(%f32_1 : !pto.tile_buf<vec, 8x128xf32>)
    pto.tcvt ins(%f32_1 {rmode = #pto<round_mode TRUNC>, satmode = #pto<saturation_mode ON>} : !pto.tile_buf<vec, 8x128xf32>)
      outs(%i32_1 : !pto.tile_buf<vec, 8x128xi32>)
    pto.tcvt ins(%f32_2 {rmode = #pto<round_mode RINT>} : !pto.tile_buf<vec, 8x128xf32>)
      outs(%bf16_1 : !pto.tile_buf<vec, 8x128xbf16>)
    pto.tcvt ins(%f32_2 {rmode = #pto<round_mode ROUND>} : !pto.tile_buf<vec, 8x128xf32>)
      outs(%f16_2 : !pto.tile_buf<vec, 8x128xf16>)
    pto.tcvt ins(%i32 {rmode = #pto<round_mode ROUND>} : !pto.tile_buf<vec, 8x128xi32>)
      outs(%f16_1 : !pto.tile_buf<vec, 8x128xf16>)
    return
  }
}

// EXPAND-COUNT-7: call {{.*}}__vmi_tcvt
// EXPAND-COUNT-7: pto.tilelib.impl = "vmi"

// INLINE-LABEL: func.func @local_convert_candidates
// INLINE-DAG: pto.vmi.vcvt {{.*}} : !pto.vmi.vreg<128xbf16> -> !pto.vmi.vreg<128xf32>
// INLINE-DAG: pto.vmi.vcvt {{.*}} : !pto.vmi.vreg<128xf16> -> !pto.vmi.vreg<128xf32>
// INLINE-DAG: pto.vmi.vcvt {{.*}}rounding = "A"{{.*}} : !pto.vmi.vreg<128xi32> -> !pto.vmi.vreg<128xf32>
// INLINE-DAG: pto.vmi.vcvt {{.*}}rounding = "Z"{{.*}}saturate = "SAT"{{.*}} : !pto.vmi.vreg<128xf32> -> !pto.vmi.vreg<128xi32>
// INLINE-DAG: pto.vmi.vcvt {{.*}}rounding = "R"{{.*}}saturate = "NOSAT"{{.*}} : !pto.vmi.vreg<128xf32> -> !pto.vmi.vreg<128xbf16>
// INLINE-DAG: pto.vmi.vcvt {{.*}}rounding = "A"{{.*}}saturate = "NOSAT"{{.*}} : !pto.vmi.vreg<128xf32> -> !pto.vmi.vreg<128xf16>
// INLINE-DAG: %[[I32_TO_F32:.*]] = pto.vmi.vcvt {{.*}}rounding = "A"{{.*}} : !pto.vmi.vreg<128xi32> -> !pto.vmi.vreg<128xf32>
// INLINE-DAG: pto.vmi.vcvt %[[I32_TO_F32]] {{.*}}rounding = "A"{{.*}}saturate = "NOSAT"{{.*}} : !pto.vmi.vreg<128xf32> -> !pto.vmi.vreg<128xf16>

// FINAL-LABEL: func.func @local_convert_candidates
// FINAL-NOT: pto.vmi.
// FINAL-DAG: pto.vcvt {{.*}} {part = "EVEN"} : !pto.vreg<128xbf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
// FINAL-DAG: pto.vcvt {{.*}} {part = "ODD"} : !pto.vreg<128xbf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
// FINAL-DAG: pto.vcvt {{.*}} {part = "EVEN"} : !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
// FINAL-DAG: pto.vcvt {{.*}} {part = "ODD"} : !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
// FINAL-DAG: pto.vcvt {{.*}} {rnd = "A"} : !pto.vreg<64xi32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// FINAL-DAG: pto.vcvt {{.*}} {rnd = "Z", sat = "SAT"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xi32>
// FINAL-DAG: pto.vcvt {{.*}} {part = "EVEN", rnd = "R", sat = "NOSAT"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<128xbf16>
// FINAL-DAG: pto.vcvt {{.*}} {part = "EVEN", rnd = "A", sat = "NOSAT"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<128xf16>
// FINAL-DAG: pto.vsts {{.*}} {dist = "PK_B32"} : !pto.vreg<128xbf16>, !pto.ptr<bf16, ub>, !pto.mask<b32>
// FINAL-DAG: pto.vsts {{.*}} {dist = "PK_B32"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b32>
