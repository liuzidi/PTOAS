// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s

module {
  func.func @reduce_addf_partial_chunk(
      %source: !pto.vmi.vreg<8xf32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<8xb32, #pto.vmi.layout<contiguous>>)
      -> !pto.vreg<64xf32> {
    %out = pto.vmi.vcadd %source, %mask {reassoc}
        : !pto.vmi.vreg<8xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<8xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
    %part = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>)
        -> !pto.vreg<64xf32>
    return %part : !pto.vreg<64xf32>
  }

  func.func @reduce_addi_partial_chunk(
      %source: !pto.vmi.vreg<32xi32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<32xb32, #pto.vmi.layout<contiguous>>)
      -> !pto.vreg<64xi32> {
    %out = pto.vmi.vcadd %source, %mask
        : !pto.vmi.vreg<32xi32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<32xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xi32, #pto.vmi.layout<contiguous>>
    %part = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<1xi32, #pto.vmi.layout<contiguous>>)
        -> !pto.vreg<64xi32>
    return %part : !pto.vreg<64xi32>
  }

  func.func @reduce_maxf_partial_chunk(
      %source: !pto.vmi.vreg<32xf32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<32xb32, #pto.vmi.layout<contiguous>>)
      -> !pto.vreg<64xf32> {
    %out = pto.vmi.vcmax %source, %mask
        : !pto.vmi.vreg<32xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<32xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
    %part = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>)
        -> !pto.vreg<64xf32>
    return %part : !pto.vreg<64xf32>
  }

  func.func @reduce_minf_partial_chunk(
      %source: !pto.vmi.vreg<64xf16, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<64xb16, #pto.vmi.layout<contiguous>>)
      -> !pto.vreg<128xf16> {
    %out = pto.vmi.vcmin %source, %mask
        : !pto.vmi.vreg<64xf16, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<64xb16, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xf16, #pto.vmi.layout<contiguous>>
    %part = "pto.vmi.unpack"(%out)
        : (!pto.vmi.vreg<1xf16, #pto.vmi.layout<contiguous>>)
        -> !pto.vreg<128xf16>
    return %part : !pto.vreg<128xf16>
  }

  func.func @reduce_maxf_multichunk_tail(
      %source: !pto.vmi.vreg<65xf32, #pto.vmi.layout<contiguous>>,
      %mask: !pto.vmi.mask<65xb32, #pto.vmi.layout<contiguous>>) {
    %out = pto.vmi.vcmax %source, %mask
        : !pto.vmi.vreg<65xf32, #pto.vmi.layout<contiguous>>,
          !pto.vmi.mask<65xb32, #pto.vmi.layout<contiguous>>
        -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<contiguous>>
    return
  }
}

// CHECK-LABEL: func.func @reduce_addf_partial_chunk(
// CHECK: %[[VALID8:.*]] = pto.pge_b32 "PAT_VL8" : !pto.mask<b32>
// CHECK: %[[ALL0:.*]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// CHECK: %[[MASK8:.*]] = pto.pand %arg1, %[[VALID8]], %[[ALL0]]
// CHECK: pto.vcadd %arg0, %[[MASK8]]
// CHECK-LABEL: func.func @reduce_addi_partial_chunk(
// CHECK: %[[VALID32I:.*]] = pto.pge_b32 "PAT_VL32" : !pto.mask<b32>
// CHECK: %[[ALLI:.*]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// CHECK: %[[MASK32I:.*]] = pto.pand %arg1, %[[VALID32I]], %[[ALLI]]
// CHECK: pto.vcadd %arg0, %[[MASK32I]]
// CHECK-LABEL: func.func @reduce_maxf_partial_chunk(
// CHECK: %[[VALID32:.*]] = pto.pge_b32 "PAT_VL32" : !pto.mask<b32>
// CHECK: %[[ALL1:.*]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// CHECK: %[[MASK32:.*]] = pto.pand %arg1, %[[VALID32]], %[[ALL1]]
// CHECK: pto.vcmax %arg0, %[[MASK32]]
// CHECK-LABEL: func.func @reduce_minf_partial_chunk(
// CHECK: %[[VALID64:.*]] = pto.pge_b16 "PAT_VL64" : !pto.mask<b16>
// CHECK: %[[ALL16:.*]] = pto.pset_b16 "PAT_ALL" : !pto.mask<b16>
// CHECK: %[[MASK64:.*]] = pto.pand %arg1, %[[VALID64]], %[[ALL16]]
// CHECK: pto.vcmin %arg0, %[[MASK64]]
// CHECK-LABEL: func.func @reduce_maxf_multichunk_tail(
// CHECK: %[[VALID1:.*]] = pto.pge_b32 "PAT_VL1" : !pto.mask<b32>
// CHECK: %[[ALL2:.*]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// CHECK: %[[TAIL_MASK:.*]] = pto.pand %arg3, %[[VALID1]], %[[ALL2]]
// CHECK: pto.vcmax %arg0, %arg2
// CHECK: pto.vcmax %arg1, %[[TAIL_MASK]]
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
