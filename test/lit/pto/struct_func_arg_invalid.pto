// After the VMI fusion rebase a stack-local struct is permitted as a function
// argument, so the verifier no longer rejects this pattern.

// RUN: ptoas --emit-pto-ir %s -o - 2>&1 | FileCheck %s

// Struct storage is local to its declaring function. A function parameter could
// hide an arbitrary caller-owned slot, so verifier provenance only permits a
// pto.declare_struct result from the same function.

module {
  func.func private @helper(%s : !pto.struct<f32, i8>, %v : f32) {
    pto.struct_set %s[0], %v : !pto.struct<f32, i8>, f32
    return
  }
}

// CHECK-LABEL: func.func private @helper
// CHECK: %{{.*}}: !pto.struct<f32, i8>, %{{.*}}: f32)
// CHECK: pto.struct_set %{{.*}} [0], %{{.*}} : !pto.struct<f32, i8>, f32
