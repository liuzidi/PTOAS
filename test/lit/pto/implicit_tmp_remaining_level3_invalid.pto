// After the VMI fusion rebase the implicit-tmp pass materializes an implicit
// tmp for these ops at level3 instead of rejecting them, so they now lower
// successfully. These sub-tests verify the materialized IR form.

// RUN: split-file %s %t
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir %t/tprelu.pto 2>&1 | FileCheck %s --check-prefix=TPRELU
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir %t/tcvt.pto 2>&1 | FileCheck %s --check-prefix=TCVT
// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir %t/tmrgsort.pto 2>&1 | FileCheck %s --check-prefix=TMRGSORT

//--- tprelu.pto
module {
  func.func @tprelu_missing_tmp() {
    %a0 = arith.constant 0 : i64
    %a1 = arith.constant 256 : i64
    %a2 = arith.constant 512 : i64
    %src0 = pto.alloc_tile addr = %a0 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %src1 = pto.alloc_tile addr = %a1 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile addr = %a2 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tprelu ins(%src0, %src1 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}

// TPRELU-LABEL: func.func @tprelu_missing_tmp
// TPRELU: pto.tprelu ins(%{{.*}}, %{{.*}} : !pto.tile_buf<vec, 1x8xf32>, !pto.tile_buf<vec, 1x8xf32>) outs(%{{.*}} : !pto.tile_buf<vec, 1x8xf32>)

//--- tcvt.pto
module {
  func.func @tcvt_missing_tmp() {
    %a0 = arith.constant 0 : i64
    %a1 = arith.constant 256 : i64
    %src = pto.alloc_tile addr = %a0 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=16, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile addr = %a1 : !pto.tile_buf<loc=vec, dtype=i16, rows=1, cols=16, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tcvt ins(%src {satmode = #pto<saturation_mode OFF>} : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=16, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%dst : !pto.tile_buf<loc=vec, dtype=i16, rows=1, cols=16, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}

// TCVT-LABEL: func.func @tcvt_missing_tmp
// TCVT: pto.tcvt ins(%{{.*}} {rmode = #pto<round_mode CAST_RINT>, satmode = #pto<saturation_mode OFF>} : !pto.tile_buf<vec, 1x16xf32, valid=1x8>) outs(%{{.*}} : !pto.tile_buf<vec, 1x16xi16, valid=1x8>)

//--- tmrgsort.pto
module {
  func.func @tmrgsort_missing_tmp(%executed : vector<4xi16>) {
    %a0 = arith.constant 0 : i64
    %a1 = arith.constant 256 : i64
    %a2 = arith.constant 512 : i64
    %src0 = pto.alloc_tile addr = %a0 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %src1 = pto.alloc_tile addr = %a1 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile addr = %a2 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=128, v_row=1, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tmrgsort ins(%src0, %src1 no_tmp {exhausted = false} : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%dst, %executed : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=128, v_row=1, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>, vector<4xi16>)
    return
  }
}

// TMRGSORT-LABEL: func.func @tmrgsort_missing_tmp
// TMRGSORT: pto.tmrgsort ins(%{{.*}}, %{{.*}} no_tmp {exhausted = false} : !pto.tile_buf<vec, 1x64xf32>, !pto.tile_buf<vec, 1x64xf32>) outs(%{{.*}}, %{{.*}} : !pto.tile_buf<vec, 1x128xf32>, vector<4xi16>)
