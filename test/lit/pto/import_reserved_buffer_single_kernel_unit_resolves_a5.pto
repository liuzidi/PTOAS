// RUN: not ptoas --pto-arch=a5 --pto-backend=vpto --pto-level=level3 --vpto-emit-merged-device-only --mlir-print-ir-after=pto-resolve-reserved-buffers %s -o %t.o 2>&1 | FileCheck %s

// Merged-device VPTO compiles each kernel to its own compilation unit, so an
// import_reserved_buffer may reference a peer function that lives in another
// unit. The single-kernel-per-file shape relaxes the peer check and the
// resolver materializes the pipe slot base from the local pipe contract
// (both sides plan the base identically from shared pipe metadata), so the
// pipeline proceeds past peer resolution into VPTO LLVM emission. The
// tpop data-plane lowering is still a tracked follow-up gap, which is the
// only allowed failure below.

// CHECK: IR Dump After PTOResolveReservedBuffers
// CHECK-LABEL: func.func @qk_pv_aiv
// CHECK: pto.initialize_l2l_pipe
// CHECK-NOT: pto.import_reserved_buffer
// CHECK: error: 'pto.tpop' op must be inside pto.section.cube/vector or a kernel_kind function

module attributes {pto.target_arch = "a5"} {
  func.func @qk_pv_aiv(%arg0: !pto.ptr<f32>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0_i64 = arith.constant 0 : i64
    %c0_index = arith.constant 0 : index
    %c1_index = arith.constant 1 : index
    %c128_index = arith.constant 128 : index
    %c2_slot_buffer = pto.reserve_buffer {name = "qk_pv_c2v_slot_buffer", size = 32768, location = #pto.address_space<vec>, auto = false, base = 0} -> i32
    %c2_slot_buffer_import = pto.import_reserved_buffer {name = "qk_pv_v2c_slot_buffer", peer_func = @qk_pv_aic} -> i32
    pto.aiv_initialize_pipe {dir_mask = 3, slot_size = 16384, slot_num = 2} (c2v_consumer_buf = %c2_slot_buffer : i32, v2c_consumer_buf = %c2_slot_buffer_import : i32)
    %view = pto.make_tensor_view %arg0, shape = [%c128_index], strides = [%c1_index] {layout = #pto.layout<nd>} : !pto.tensor_view<?xf32>
    %tile = pto.alloc_tile addr = %c0_i64 valid_row = %c1_index valid_col = %c128_index : !pto.tile_buf<vec, 1x128xf32, valid=?x?>
    %pview = pto.partition_view %view, offsets = [%c0_index], sizes = [%c128_index] : !pto.tensor_view<?xf32> -> !pto.partition_tensor_view<128xf32>
    pto.tload ins(%pview : !pto.partition_tensor_view<128xf32>) outs(%tile : !pto.tile_buf<vec, 1x128xf32, valid=?x?>)
    %pop = pto.tpop_from_aic {split = 0} -> !pto.tile_buf<vec, 1x128xf32, valid=?x?>
    return
  }
}
