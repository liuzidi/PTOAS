// RUN: not ptoas --pto-level=level1 --pto-arch=a3 %s 2>&1 | FileCheck %s
// RUN: not ptoas --pto-level=level2 --pto-arch=a3 %s 2>&1 | FileCheck %s

module {
  func.func @manual_base_reject() {
    %fifo = pto.reserve_buffer {
      name = "fifo",
      size = 8192,
      location = #pto.address_space<vec>,
      auto = false,
      base = 0
    } -> i32
    return
  }
}

// CHECK: error: pto.reserve_buffer with explicit 'base' (auto = false) is not supported when --pto-level=level1 or level2
