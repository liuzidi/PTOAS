// After the VMI fusion rebase the implicit-tmp pass materializes an implicit
// tmp for pto.tci at level3 instead of rejecting it, so the op now lowers
// successfully. This test verifies the materialized IR form.

// RUN: ptoas --pto-arch=a3 --pto-level=level3 --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func @tci_implicit_tmp_level3() {
    %c0_i32 = arith.constant 0 : i32
    %addr = arith.constant 0 : i64
    %tile = pto.alloc_tile addr = %addr : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tci ins(%c0_i32 : i32)
      outs(%tile : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}

// CHECK-LABEL: func.func @tci_implicit_tmp_level3
// CHECK: pto.tci ins(%{{.*}} : i32) outs(%{{.*}} : !pto.tile_buf<vec, 1x32xi32>) {descending = false}
